# Intents Explorer API JWT (get from https://partners.near-intents.org/)
EXPLORER_JWT=
# Explorer API (rate limit: 1 request / 5 s)
EXPLORER_BASE_URL=https://explorer.near-intents.org/api/v0
# NEAR RPC (use an archival endpoint for old txs)
NEAR_RPC_URL=https://rpc.mainnet.near.org
# Optional working mainnet archival provider; keep credentialed URLs local.
ARCHIVAL_RPC_URL=
# BigQuery execution project (Sandbox supported)
GCP_PROJECT=
BQ_DATASET=bigquery-public-data.crypto_near_mainnet_us
